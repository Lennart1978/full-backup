{
  "name": "full-backup",
  "main": "_cloudflare/worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "build": {
    "command": "python3 _cloudflare/build.py",
    "watch_dir": "_cloudflare/ui"
  },
  "assets": {
    "directory": ".dashboard-dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ARCHIVE", "class_name": "BackupArchive" }]
  },
  "migrations": [{ "tag": "backup-archive-v1", "new_sqlite_classes": ["BackupArchive"] }]
}
